# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# ---- Server only. Never prefix these with NEXT_PUBLIC_ ----

# Viewer token from sanity.io/manage > API > Tokens. Used for draft preview.
SANITY_API_READ_TOKEN=

# Any random string. Guards the /api/draft-mode/enable route.
# Generate: openssl rand -hex 32
SANITY_PREVIEW_SECRET=

# Any random string. Must match the Secret field on the Sanity webhook.
# Generate: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# Used by the Presentation tool in the Studio to know where the site lives.
SANITY_STUDIO_PREVIEW_ORIGIN=https://thelindleyteam.com
