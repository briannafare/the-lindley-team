# ── The Lindley Team — environment variables ────────────────────────────────
# Copy to .env.local for local dev, and set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
#
# HOW IT FITS TOGETHER
# - Website forms POST to /api/lead with a formType.
# - /api/lead forwards to the matching GHL webhook below (PRIVATE — no NEXT_PUBLIC_).
# - Booking calendars are LeadConnector embeds rendered in the browser, so they
#   use NEXT_PUBLIC_ vars.

# ── GHL inbound webhooks (one per workflow) ──────────────────────────────────
# GHL → Automation → Workflows → Create Workflow → Add Trigger → Webhook.
# Each gives a URL like https://services.leadconnectorhq.com/hooks/xxxxxxxx
GHL_WEBHOOK_SCHEDULE=
# First-time buyers route to their own workflow; falls back to SCHEDULE if unset.
GHL_WEBHOOK_FIRST_TIME=
GHL_WEBHOOK_RATE_QUOTE=
GHL_WEBHOOK_CALCULATOR=
GHL_WEBHOOK_NEIGHBORHOOD=
GHL_WEBHOOK_GUIDE=
GHL_WEBHOOK_DIVORCE=
GHL_WEBHOOK_APPLY_CLICK=

# ── GHL booking calendars (per request type) ────────────────────────────────
# GHL → Calendars → open the calendar → Embed. Use the widget/booking URL,
# e.g. https://api.leadconnectorhq.com/widget/booking/XXXXXXXX
NEXT_PUBLIC_GHL_CAL_SCHEDULE=
NEXT_PUBLIC_GHL_CAL_DIVORCE=
NEXT_PUBLIC_GHL_CAL_RATE_QUOTE=
NEXT_PUBLIC_GHL_CAL_FIRST_TIME=

# ── Existing integrations (already referenced in the code) ───────────────────
# Calculator posts its results form here (legacy direct webhook; can migrate to
# /api/lead formType=calculator later).
NEXT_PUBLIC_GHL_CALC_WEBHOOK=
# GHL LeadConnector chat widget location id (already hardcoded in layout.tsx as
# pe2yBdfaVo406b3BaavZ — move here if you want it env-driven).
NEXT_PUBLIC_GHL_LOCATION_ID=pe2yBdfaVo406b3BaavZ
